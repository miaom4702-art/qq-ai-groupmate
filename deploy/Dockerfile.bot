FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LOCALSTORE_USE_CWD=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY patches /patches

RUN pip install -U pip \
    && pip install "nonebot2[fastapi]" "nonebot-adapter-onebot" "nonebot-plugin-orm" aiosqlite \
    && git clone https://github.com/yaowan233/nonebot-plugin-ai-groupmate /opt/ai-groupmate \
    && git -C /opt/ai-groupmate checkout 431cb42 \
    && git -C /opt/ai-groupmate apply /patches/ai-groupmate-active-groups.patch \
    && pip install -e /opt/ai-groupmate

COPY bot/bot.py bot/pyproject.toml /app/
RUN mkdir -p /app/plugins /app/data /app/config /app/cache

RUN pip install nb-cli
COPY deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080
CMD ["/app/entrypoint.sh"]
